# Copia questo file in ".env" e compila i valori per il tuo ambiente.
# Il file ".env" NON va committato (è ignorato da git): contiene i segreti locali.

# Porta su cui ascolta l'API (se assente, il codice usa 3000)
PORT=3333

#### CONFIGURAZIONE DATABASE POSTGRES
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=la_tua_password
PG_DATABASE=PFSProject

#### Segreto per la firma dei JWT. Genera un valore casuale, es.:
#### node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SECRET_KEY=inserisci_una_stringa_esadecimale_casuale
